---
import { withBase } from '../lib/url';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="desk">
      <div class="notebook">
        <header>
          <a href={withBase('/')} class="site-title">流麗の思考記録</a>
        </header>
        <div class="page">
          <main>
            <slot />
          </main>
        </div>
      </div>
    </div>
    <style is:global>
      :root {
        color-scheme: light;
        --desk: #e8e2d6;
        --paper: #fffef9;
        --ink: #2b2a27;
        --accent: #2f4a5f;
        --margin-line: #e3a7a0;
      }
      body {
        margin: 0;
        font-family: "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
        line-height: 1.9;
        color: var(--ink);
        background: var(--desk);
      }
      .desk {
        padding: 1.5rem 1rem 4rem;
      }
      .notebook {
        max-width: 760px;
        margin: 0 auto;
      }

      /* ノートの見出しタブ（ヘッダー） */
      header {
        margin: 0 0 0 2.5rem;
      }
      .site-title {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        padding: 0.45rem 1.2rem;
        border-radius: 6px 6px 0 0;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.6;
        text-decoration: none;
      }

      /* 紙のページ */
      .page {
        position: relative;
        background: var(--paper);
        border-radius: 2px 6px 6px 2px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15), 0 8px 24px rgba(0, 0, 0, 0.08);
        padding: 2.5rem 2rem 3.5rem 4.25rem;
      }
      /* 余白の赤線 */
      .page::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 3.2rem;
        width: 1px;
        background: var(--margin-line);
      }
      /* 綴じ穴 */
      .page::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0.9rem;
        width: 0.9rem;
        background: radial-gradient(circle at center, var(--desk) 0 0.35rem, transparent 0.36rem) 0 0 / 0.9rem 6rem repeat-y;
        pointer-events: none;
      }

      h1 {
        font-size: 1.6rem;
        line-height: 1.5;
        margin-top: 0;
        margin-bottom: 0.5rem;
      }
      h2 {
        font-size: 1.15rem;
        margin-top: 3rem;
      }
      /* 区切り（記事の要約／問い／検討など）を付箋風に */
      h3 {
        display: inline-block;
        margin: 2.5rem 0 0.5rem;
        padding: 0.05rem 0.9rem;
        font-size: 0.95rem;
        line-height: 1.8;
        background: #f6ecc6;
        border-left: 4px solid #d9c98f;
        border-radius: 2px 4px 4px 2px;
      }
      a {
        color: #1a5276;
      }
      time {
        display: block;
        font-size: 0.85rem;
        color: #777;
        margin-bottom: 2rem;
      }

      /* 目次（問いの一覧） */
      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin: 0;
        padding: 0.6rem 0;
        border-bottom: 1px dashed #d9d4c7;
      }
      .post-list a {
        font-size: 1.05rem;
        text-decoration: none;
      }
      .post-list a:hover {
        text-decoration: underline;
      }
      .post-list time {
        display: inline;
        margin-left: 0.75rem;
      }

      article .content h2 {
        margin-top: 2.5rem;
      }
      article .content p {
        margin: 1.1em 0;
      }
      .meta {
        font-size: 0.85rem;
        color: #777;
      }
      .meta.topics a {
        margin-right: 0.75rem;
      }
      .sources {
        margin: 1.5rem 0 2.5rem;
        padding: 0.9rem 1.1rem;
        background: #f4f2ee;
        border-radius: 4px;
      }
      .sources ul {
        margin: 0.3rem 0 0;
        padding-left: 1.2rem;
      }

      /* テーマ一覧：しおり風のタグ */
      .topic-list {
        list-style: none;
        padding: 0;
      }
      .topic-list li {
        display: inline-block;
        margin: 0 0.6rem 0.6rem 0;
      }
      .topic-list a {
        display: inline-block;
        padding: 0.15rem 0.9rem;
        background: #e6edf2;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.95rem;
      }
      .topic-list a:hover {
        background: #d5e1ea;
      }

      @media (max-width: 600px) {
        .desk {
          padding: 0.75rem 0.5rem 3rem;
        }
        header {
          margin-left: 1.25rem;
        }
        .page {
          padding: 1.75rem 1.1rem 2.5rem 2.6rem;
        }
        .page::before {
          left: 1.9rem;
        }
        .page::after {
          display: none;
        }
      }
    </style>
  </body>
</html>
